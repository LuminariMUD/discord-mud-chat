# Required Discord bot credential; keep the real value out of Git and logs.
DISCORD_TOKEN=your_discord_bot_token_here

# Optional MUD shared token, loaded only from environment. Requires mud_tls=true.
# Leave unset for a local plaintext loopback endpoint, including local Duris.
# MUD_AUTH_TOKEN=your_mud_auth_token_here

# Optional private CA certificate file. Set before Node starts; in containers
# this must name a read-only mounted CONTAINER path, not a host-only path.
# NODE_EXTRA_CA_CERTS=/run/certs/mud-ca.pem

# Health binds to 127.0.0.1 in this process's network namespace.
# HEALTH_PORT=3000

# Logging verbosity: error, warn, info, debug. Never log tokens/private bodies.
# LOG_LEVEL=info

# If this deploy is running on the same location as the MUD server, show path,
#   otherwise false ... examples:
# MUD_SERVER_PATH=/home/staging/duris
# MUD_SERVER_PATH=false
